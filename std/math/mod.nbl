# Nimble Standard Library - Mathematics
#
# Provides trigonometric, logarithmic, power, and utility math functions.
# All operations are backed by the runtime (C math library).

extern fn nimble_sin(x: Float) -> Float
extern fn nimble_cos(x: Float) -> Float
extern fn nimble_tan(x: Float) -> Float
extern fn nimble_asin(x: Float) -> Float
extern fn nimble_acos(x: Float) -> Float
extern fn nimble_atan(x: Float) -> Float
extern fn nimble_atan2(y: Float, x: Float) -> Float
extern fn nimble_sinh(x: Float) -> Float
extern fn nimble_cosh(x: Float) -> Float
extern fn nimble_tanh(x: Float) -> Float
extern fn nimble_sqrt(x: Float) -> Float
extern fn nimble_cbrt(x: Float) -> Float
extern fn nimble_pow(b: Float, e: Float) -> Float
extern fn nimble_floor(x: Float) -> Float
extern fn nimble_ceil(x: Float) -> Float
extern fn nimble_round(x: Float) -> Float
extern fn nimble_trunc(x: Float) -> Float
extern fn nimble_fabs(x: Float) -> Float
extern fn nimble_log(x: Float) -> Float
extern fn nimble_log2(x: Float) -> Float
extern fn nimble_log10(x: Float) -> Float
extern fn nimble_exp(x: Float) -> Float
extern fn nimble_fma(a: Float, b: Float, c: Float) -> Float
extern fn nimble_hypot(a: Float, b: Float) -> Float
extern fn nimble_fmod(a: Float, b: Float) -> Float
extern fn nimble_is_nan(x: Float) -> Int
extern fn nimble_is_infinite(x: Float) -> Int
extern fn nimble_is_finite(x: Float) -> Int
extern fn nimble_next_after(x: Float, y: Float) -> Float

fn PI() -> Float:
    return 3.141592653589793

fn E() -> Float:
    return 2.718281828459045

fn TAU() -> Float:
    return 6.283185307179586

fn INF() -> Float:
    return 1.0 / 0.0

fn math_sin(x: Float) -> Float:
    return nimble_sin(x)

fn math_cos(x: Float) -> Float:
    return nimble_cos(x)

fn math_tan(x: Float) -> Float:
    return nimble_tan(x)

fn math_asin(x: Float) -> Float:
    return nimble_asin(x)

fn math_acos(x: Float) -> Float:
    return nimble_acos(x)

fn math_atan(x: Float) -> Float:
    return nimble_atan(x)

fn math_atan2(y: Float, x: Float) -> Float:
    return nimble_atan2(y, x)

fn math_sinh(x: Float) -> Float:
    return nimble_sinh(x)

fn math_cosh(x: Float) -> Float:
    return nimble_cosh(x)

fn math_tanh(x: Float) -> Float:
    return nimble_tanh(x)

fn math_sqrt(x: Float) -> Float:
    return nimble_sqrt(x)

fn math_cbrt(x: Float) -> Float:
    return nimble_cbrt(x)

fn math_pow(b: Float, e: Float) -> Float:
    return nimble_pow(b, e)

fn math_floor(x: Float) -> Float:
    return nimble_floor(x)

fn math_ceil(x: Float) -> Float:
    return nimble_ceil(x)

fn math_round(x: Float) -> Float:
    return nimble_round(x)

fn math_trunc(x: Float) -> Float:
    return nimble_trunc(x)

fn math_abs(x: Float) -> Float:
    return nimble_fabs(x)

fn math_ln(x: Float) -> Float:
    return nimble_log(x)

fn math_log2(x: Float) -> Float:
    return nimble_log2(x)

fn math_log10(x: Float) -> Float:
    return nimble_log10(x)

fn math_exp(x: Float) -> Float:
    return nimble_exp(x)

fn math_fma(a: Float, b: Float, c: Float) -> Float:
    return nimble_fma(a, b, c)

fn math_hypot(a: Float, b: Float) -> Float:
    return nimble_hypot(a, b)

fn math_fmod(a: Float, b: Float) -> Float:
    return nimble_fmod(a, b)

fn math_is_nan(x: Float) -> Bool:
    if nimble_is_nan(x) != 0:
        return true
    return false

fn math_is_infinite(x: Float) -> Bool:
    if nimble_is_infinite(x) != 0:
        return true
    return false

fn math_is_finite(x: Float) -> Bool:
    if nimble_is_finite(x) != 0:
        return true
    return false

fn math_next_after(x: Float, y: Float) -> Float:
    return nimble_next_after(x, y)

fn degrees_to_radians(degrees: Float) -> Float:
    return degrees * PI() / 180.0

fn radians_to_degrees(radians: Float) -> Float:
    return radians * 180.0 / PI()

fn lerp(a: Float, b: Float, t: Float) -> Float:
    if t < 0.0:
        return a
    elif t > 1.0:
        return b
    return a + (b - a) * t
