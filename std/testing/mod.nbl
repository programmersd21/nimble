# Nimble Standard Library - Testing framework
#
# Provides assertion helpers and test runner for unit testing.

load std.io::{print_no_newline, print_int, print}

extern fn nimble_panic(msg: String) -> Void

fn assert_eq_int(expected: Int, actual: Int) -> Void:
    if expected != actual:
        print("[FAIL] assert_eq: expected ")
        print_int(expected)
        print_no_newline(" but got ")
        print_int(actual)
        nimble_panic("assertion failed")
    print_no_newline(".")

fn assert_true(condition: Bool, message: String) -> Void:
    if !condition:
        print("[FAIL] ")
        print(message)
        nimble_panic("assertion failed")
    print_no_newline(".")

fn assert_false(condition: Bool, message: String) -> Void:
    if condition:
        print("[FAIL] ")
        print(message)
        nimble_panic("assertion failed")
    print_no_newline(".")

fn run_test(name: String, test_fn: fn() -> Void) -> Void:
    print_no_newline("test ")
    print_no_newline(name)
    print_no_newline(": ")
    test_fn()
    print(" OK")
