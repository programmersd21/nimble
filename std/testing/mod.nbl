# Nimble Standard Library - Testing helpers

load std.io::{print_str, print_int, print}
load std.core.panic

fn assert_eq[T](expected: T, actual: T) -> Void:
    if expected != actual:
        print_str("[FAIL] assert_eq: expected ")
        print_int(expected as Int)
        print_str(" but got ")
        print_int(actual as Int)
        print("")
        panic("assertion failed")
    print_str(".")

fn assert_true(condition: Bool, message: String) -> Void:
    if !condition:
        print_str("[FAIL] ")
        print(message)
        panic("assertion failed")
    print_str(".")

fn assert_ok[T, E](result: Result[T, E]) -> T:
    match result:
        Ok(val):
            print_str(".")
            return val
        Err(e):
            print_str("[FAIL] expected Ok, got Err")
            panic("assertion failed")

fn run_test(name: String, test_fn: fn() -> Void) -> Void:
    print_str("Testing ")
    print(name)
    print_str(": ")
    test_fn()
    print(" OK")
