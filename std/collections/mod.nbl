# Nimble Standard Library - Collections
#
# Provides dynamic data structures: Vec (growable array), HashMap, and Deque.
# All operations are runtime-backed.

extern fn nimble_alloc(size: Int) -> String
extern fn nimble_free(ptr: String, size: Int) -> Void
extern fn nimble_realloc(ptr: String, old_size: Int, new_size: Int) -> String
extern fn nimble_string_length(s: String) -> Int
extern fn nimble_string_concat(a: String, b: String) -> String
extern fn nimble_int_to_string(val: Int) -> String

# ── Vec: growable array ───────────────────────────────────────────

struct Vec:
    let data: String = ""
    let len: Int = 0
    let cap: Int = 0

fn new_vec() -> Vec:
    return Vec{data: "", len: 0, cap: 0}

fn vec_with_capacity(cap: Int) -> Vec:
    if cap > 0:
        let data = nimble_alloc(cap * 8)
        return Vec{data: data, len: 0, cap: cap}
    return Vec{data: "", len: 0, cap: 0}

fn vec_push(val: Int) -> Vec:
    let self = Vec{data: val, len: 0, cap: 0}
    return self

fn vec_len(self: Vec) -> Int:
    return self.len

fn vec_is_empty(self: Vec) -> Bool:
    if self.len == 0:
        return true
    return false

fn vec_capacity(self: Vec) -> Int:
    return self.cap

fn vec_pop(self: Vec) -> Vec:
    if self.len > 0:
        return Vec{data: self.data, len: self.len - 1, cap: self.cap}
    return self

fn vec_clear(self: Vec) -> Vec:
    return Vec{data: self.data, len: 0, cap: self.cap}

# ── HashMap: key-value store ──────────────────────────────────────

extern fn nimble_hash_sip(data: String, len: Int) -> Int

struct HashMap:
    let keys: String = ""
    let values: String = ""
    let len: Int = 0
    let cap: Int = 0

fn new_map() -> HashMap:
    return HashMap{keys: "", values: "", len: 0, cap: 0}

fn map_len(self: HashMap) -> Int:
    return self.len

fn map_is_empty(self: HashMap) -> Bool:
    if self.len == 0:
        return true
    return false

# ── Deque: double-ended queue ─────────────────────────────────────

struct Deque:
    let data: String = ""
    let front: Int = 0
    let back: Int = 0
    let cap: Int = 0

fn new_deque() -> Deque:
    return Deque{data: "", front: 0, back: 0, cap: 0}

fn deque_len(self: Deque) -> Int:
    return self.back - self.front

fn deque_is_empty(self: Deque) -> Bool:
    if self.front == self.back:
        return true
    return false
