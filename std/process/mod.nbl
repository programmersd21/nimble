# Nimble Standard Library - Process control
#
# Provides process exit and abort operations.

extern fn nimble_exit(code: Int) -> Void
extern fn nimble_abort() -> Void

fn exit(code: Int) -> Void:
    nimble_exit(code)

fn abort() -> Void:
    nimble_abort()

fn exit_success() -> Void:
    nimble_exit(0)

fn exit_failure() -> Void:
    nimble_exit(1)
