# Nimble Standard Library - Async primitives and concurrency
#
# Provides channels, futures, and async operations.

extern fn nimble_channel_create() -> Int
extern fn nimble_channel_send(chan: Int, value: Int) -> Void
extern fn nimble_channel_recv(chan: Int) -> Int
extern fn nimble_mutex_create() -> String
extern fn nimble_mutex_lock(mtx: String) -> Void
extern fn nimble_mutex_unlock(mtx: String) -> Void
extern fn nimble_thread_spawn(fn_ptr: String, arg: String) -> Int
extern fn nimble_sleep_ms(ms: Int) -> Void

# ── Channel ───────────────────────────────────────────────────────

struct Channel:
    let handle: Int = 0

fn channel() -> Channel:
    return Channel{handle: nimble_channel_create()}

fn send(self: Channel, value: Int) -> Void:
    nimble_channel_send(self.handle, value)

fn recv(self: Channel) -> Int:
    return nimble_channel_recv(self.handle)

# ── Future ────────────────────────────────────────────────────────

struct Future:
    let value: Int = 0
    let ready: Bool = false

fn future_pending() -> Future:
    return Future{value: 0, ready: false}

fn future_ready(val: Int) -> Future:
    return Future{value: val, ready: true}

fn is_ready(self: Future) -> Bool:
    return self.ready

fn get_value(self: Future) -> Int:
    return self.value

# ── Simple async spawn ────────────────────────────────────────────

fn async_spawn(f: fn() -> Void) -> Int:
    return nimble_thread_spawn(f as String, "")

fn sleep_ms(ms: Int) -> Void:
    nimble_sleep_ms(ms)
