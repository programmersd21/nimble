# Nimble Standard Library - Base64 encoding
#
# Provides base64 encoding and decoding with standard and URL-safe variants.

extern fn nimble_base64_encode(data: String, len: Int, url_safe: Int) -> String
extern fn nimble_base64_decode(data: String, len: Int) -> String
extern fn nimble_string_length(s: String) -> Int

fn encode_b64(data: String) -> String:
    return nimble_base64_encode(data, nimble_string_length(data), 0)

fn encode_b64_url_safe(data: String) -> String:
    return nimble_base64_encode(data, nimble_string_length(data), 1)

fn decode_b64(data: String) -> String:
    return nimble_base64_decode(data, nimble_string_length(data))
