# Nimble Standard Library - Core utilities

fn abs_i(x: Int) -> Int:
    if x < 0:
        return -x
    return x

fn max_i(a: Int, b: Int) -> Int:
    if a >= b:
        return a
    return b

fn min_i(a: Int, b: Int) -> Int:
    if a <= b:
        return a
    return b

fn clamp(value: Int, low: Int, high: Int) -> Int:
    if value < low:
        return low
    elif value > high:
        return high
    return value
