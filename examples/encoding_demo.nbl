# Nimble Encoding Demo
# Demonstrates base64 and hex encoding/decoding

load std.io
load std.encoding.base64
load std.encoding.hex

fn main() -> Int:
    # Base64 standard
    let data = "hello world"
    let encoded = std.encoding.base64.encode_b64(data)
    std.io.print_no_newline("base64: ")
    std.io.print(encoded)

    let decoded = std.encoding.base64.decode_b64(encoded)
    std.io.print_no_newline("decoded: ")
    std.io.print(decoded)

    # Base64 URL-safe
    let url_encoded = std.encoding.base64.encode_b64_url_safe(data)
    std.io.print_no_newline("base64url: ")
    std.io.print(url_encoded)

    # Hex encoding (lowercase)
    let hex_lower = std.encoding.hex.encode_hex(data)
    std.io.print_no_newline("hex lower: ")
    std.io.print(hex_lower)

    # Hex encoding (uppercase)
    let hex_upper = std.encoding.hex.encode_hex_upper(data)
    std.io.print_no_newline("hex upper: ")
    std.io.print(hex_upper)

    return 0
