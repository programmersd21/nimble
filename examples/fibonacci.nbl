# Nimble Fibonacci
# Recursive fibonacci with tail-call-like structure

extern fn nimble_print_str(s: String) -> Void
extern fn nimble_print_i64(x: Int) -> Void

fn fib(n: Int) -> Int:
    if n <= 1:
        return n
    else:
        return fib(n - 1) + fib(n - 2)

fn main() -> Int:
    let n = 40
    nimble_print_str("fibonacci(")
    nimble_print_i64(n)
    nimble_print_str(") = ")
    nimble_print_i64(fib(n))
    return 0
