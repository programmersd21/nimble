# Nimble Fibonacci
# Recursive fibonacci with tail-call-like structure

load std.io

fn fib(n: Int) -> Int:
    if n <= 1:
        return n
    else:
        return fib(n - 1) + fib(n - 2)

fn main() -> Int:
    let n = 40
    std.io.print_no_newline("fibonacci(")
    std.io.print_int(n)
    std.io.print_no_newline(") = ")
    std.io.print_int(fib(n))
    return 0
