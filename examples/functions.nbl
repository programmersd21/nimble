# Nimble Functions Demo
# Functions, recursion, and composition

load std.io

fn double(x: Int) -> Int:
    return x * 2

fn apply(f: Int, g: Int) -> Int:
    return double(f) + double(g)

fn recursive(n: Int) -> Int:
    if n == 0:
        return 1
    else:
        return n * recursive(n - 1)

fn main() -> Int:
    let r1 = double(21)
    std.io.print_int(r1)

    let r2 = apply(3, 4)
    std.io.print_int(r2)

    let r3 = recursive(5)
    std.io.print_int(r3)

    return 0
