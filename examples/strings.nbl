# Nimble String Operations Demo
# Demonstrates runtime-backed string manipulation

load std.io
load std.str

fn main() -> Int:
    let s = "Hello, Nimble!"

    # Length
    std.io.print_no_newline("length: ")
    std.io.print_int(std.str.length(s))

    # Concat
    let greeting = std.str.concat("Hello", " World")
    std.io.print_no_newline("concat: ")
    std.io.print(greeting)

    # Substring
    let sub = std.str.substring(s, 0, 5)
    std.io.print_no_newline("substring(0,5): ")
    std.io.print(sub)

    # Find
    let pos = std.str.find(s, "Nimble")
    std.io.print_no_newline("find 'Nimble': ")
    std.io.print_int(pos)

    # Trim
    let padded = "  spaced  "
    let trimmed = std.str.trim(padded)
    std.io.print_no_newline("trimmed: '")
    std.io.print_no_newline(trimmed)
    std.io.print("'")

    # Case conversion
    let upper = std.str.to_upper(s)
    std.io.print_no_newline("upper: ")
    std.io.print(upper)

    let lower = std.str.to_lower(s)
    std.io.print_no_newline("lower: ")
    std.io.print(lower)

    # Starts/ends with
    let sw = std.str.starts_with(s, "Hello")
    std.io.print_no_newline("starts with Hello: ")
    std.io.print_bool(sw)

    # Replace
    let replaced = std.str.replace(s, "Nimble", "World")
    std.io.print_no_newline("replace: ")
    std.io.print(replaced)

    # Repeat
    let repeated = std.str.repeat("ha", 3)
    std.io.print_no_newline("repeat: ")
    std.io.print(repeated)

    # String to int
    let n = std.str.to_int("42")
    std.io.print_no_newline("string '42' as int: ")
    std.io.print_int(n)

    # Equality
    let eq = std.str.eq("abc", "abc")
    std.io.print_no_newline("'abc' == 'abc': ")
    std.io.print_bool(eq)

    return 0
