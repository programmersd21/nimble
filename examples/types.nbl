# Nimble Types Demo
# Primitive types: Int, Float, Bool, String

load std.io

fn main() -> Int:
    let a: Int = 42
    let b: Float = 3.14
    let c: Bool = true
    let d: String = "hello"

    std.io.print_int(a)
    std.io.print(d)

    var inferred = 99
    inferred = 100
    std.io.print_int(inferred)

    return 0
