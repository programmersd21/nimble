# Nimble Types Demo
# Primitive types: Int, Float, Bool, String

extern fn nimble_print_str(s: String) -> Void
extern fn nimble_print_i64(x: Int) -> Void

fn main() -> Int:
    let a: Int = 42
    let b: Float = 3.14
    let c: Bool = true
    let d: String = "hello"

    nimble_print_i64(a)
    nimble_print_str(d)

    var inferred = 99
    inferred = 100
    nimble_print_i64(inferred)

    return 0
