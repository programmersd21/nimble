# Nimble Interfaces Demo
# Structural typing via interface conformance

extern fn nimble_print_str(s: String) -> Void
extern fn nimble_print_i64(x: Int) -> Void

interface Shape:
    fn area(self: Shape) -> Int

struct Square:
    let side: Int = 0

struct Rect:
    let width: Int = 0
    let height: Int = 0

fn square_area(s: Square) -> Int:
    return s.side * s.side

fn rect_area(r: Rect) -> Int:
    return r.width * r.height

fn main() -> Int:
    let sq = Square{side: 6}
    let r = Rect{width: 4, height: 7}

    nimble_print_str("square area: ")
    nimble_print_i64(square_area(sq))

    nimble_print_str("rect area: ")
    nimble_print_i64(rect_area(r))

    return 0
