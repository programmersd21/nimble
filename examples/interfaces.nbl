# Nimble Interfaces Demo
# Structural typing via interface conformance

load std.io

interface Shape:
    fn area(self: Shape) -> Int

struct Square:
    let side: Int = 0

struct Rect:
    let width: Int = 0
    let height: Int = 0

fn square_area(s: Square) -> Int:
    return s.side * s.side

fn rect_area(r: Rect) -> Int:
    return r.width * r.height

fn main() -> Int:
    let sq = Square{side: 6}
    let r = Rect{width: 4, height: 7}

    std.io.print_no_newline("square area: ")
    std.io.print_int(square_area(sq))

    std.io.print_no_newline("rect area: ")
    std.io.print_int(rect_area(r))

    return 0
