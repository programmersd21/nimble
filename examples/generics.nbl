# Nimble Generics Demo
# Generic struct annotations and type parameter usage

extern fn nimble_print_str(s: String) -> Void
extern fn nimble_print_i64(x: Int) -> Void

struct Box:
    let value: Int = 0

struct Pair:
    let first: Int = 0
    let second: Int = 0

fn unwrap(b: Box) -> Int:
    return b.value

fn swap(p: Pair) -> Pair:
    return Pair{first: p.second, second: p.first}

fn main() -> Int:
    let b: Box[Int] = Box{value: 42}
    nimble_print_str("unwrapped: ")
    nimble_print_i64(unwrap(b))

    let p = Pair{first: 1, second: 2}
    let q = swap(p)
    nimble_print_str("first: ")
    nimble_print_i64(q.first)
    nimble_print_str("second: ")
    nimble_print_i64(q.second)

    return 0
