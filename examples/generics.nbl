# Nimble Generics Demo
# Generic struct annotations and type parameter usage

load std.io

struct Box:
    let value: Int = 0

struct Pair:
    let first: Int = 0
    let second: Int = 0

fn unwrap(b: Box) -> Int:
    return b.value

fn swap(p: Pair) -> Pair:
    return Pair{first: p.second, second: p.first}

fn main() -> Int:
    let b: Box[Int] = Box{value: 42}
    std.io.print_no_newline("unwrapped: ")
    std.io.print_int(unwrap(b))

    let p = Pair{first: 1, second: 2}
    let q = swap(p)
    std.io.print_no_newline("first: ")
    std.io.print_int(q.first)
    std.io.print_no_newline("second: ")
    std.io.print_int(q.second)

    return 0
