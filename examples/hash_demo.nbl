# Nimble Hashing Demo
# Demonstrates FNV-1a, SipHash, and xxHash3 hashing

load std.io
load std.hash

fn main() -> Int:
    let value = "nimble"

    std.io.print_no_newline("FNV-1a:  ")
    std.io.print_int(std.hash.fnv1a(value))

    std.io.print_no_newline("SipHash: ")
    std.io.print_int(std.hash.sip(value))

    std.io.print_no_newline("xxHash3: ")
    std.io.print_int(std.hash.xxhash3(value))

    return 0
