# Nimble Operators Demo
# Arithmetic, comparison, and logical operators

extern fn nimble_print_i64(x: Int) -> Void
extern fn nimble_print_str(s: String) -> Void

fn main() -> Int:
    let a = 10
    let b = 3

    nimble_print_i64(a + b)
    nimble_print_i64(a - b)
    nimble_print_i64(a * b)
    nimble_print_i64(a / b)
    nimble_print_i64(a % b)

    let eq = a == b
    let ne = a != b
    let lt = a < b
    let gt = a > b
    let le = a <= b
    let ge = a >= b

    let and_val = true && false
    let or_val = true || false
    let not_val = !true

    let neg = -a

    return 0
