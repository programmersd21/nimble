# Nimble Operators Demo
# Arithmetic, comparison, and logical operators

load std.io

fn main() -> Int:
    let a = 10
    let b = 3

    std.io.print_int(a + b)
    std.io.print_int(a - b)
    std.io.print_int(a * b)
    std.io.print_int(a / b)
    std.io.print_int(a % b)

    let eq = a == b
    let ne = a != b
    let lt = a < b
    let gt = a > b
    let le = a <= b
    let ge = a >= b

    let and_val = true && false
    let or_val = true || false
    let not_val = !true

    let neg = -a

    return 0
