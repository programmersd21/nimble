# Nimble Booleans Demo
# Boolean logic with and, or, not

load std.io

fn test_and(a: Bool, b: Bool) -> Bool:
    return a && b

fn test_or(a: Bool, b: Bool) -> Bool:
    return a || b

fn test_not(flag: Bool) -> Bool:
    return !flag

fn main() -> Int:
    let t = true
    let f = false

    let r1 = test_and(t, t)
    let r2 = test_or(f, f)
    let r3 = test_not(f)

    if t && !f:
        std.io.print_int(1)

    if f || t:
        std.io.print_int(2)

    return 0
