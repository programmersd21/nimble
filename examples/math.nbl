extern fn print_int(x: Int) -> Void
extern fn print_str(x: String) -> Void

fn abs(x: Int) -> Int:
    if x < 0:
        return -x
    return x

fn max(a: Int, b: Int) -> Int:
    if a > b:
        return a
    return b

fn min(a: Int, b: Int) -> Int:
    if a < b:
        return a
    return b

fn main() -> Int:
    print_str("abs(-5): ")
    print_int(abs(-5))

    print_str("max(3, 7): ")
    print_int(max(3, 7))

    print_str("min(3, 7): ")
    print_int(min(3, 7))

    return 0
