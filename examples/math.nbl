# Nimble Math Demo
# Demonstrates runtime-backed math functions

load std.io
load std.math
load std.core

fn main() -> Int:
    # Trigonometry
    std.io.print_no_newline("sin(0): ")
    std.io.print_float(std.math.math_sin(0.0))

    std.io.print_no_newline("cos(0): ")
    std.io.print_float(std.math.math_cos(0.0))

    # Power and roots
    std.io.print_no_newline("sqrt(16): ")
    std.io.print_float(std.math.math_sqrt(16.0))

    std.io.print_no_newline("pow(2, 10): ")
    std.io.print_float(std.math.math_pow(2.0, 10.0))

    # Rounding
    std.io.print_no_newline("floor(3.7): ")
    std.io.print_float(std.math.math_floor(3.7))

    std.io.print_no_newline("ceil(3.2): ")
    std.io.print_float(std.math.math_ceil(3.2))

    # Integer math
    std.io.print_no_newline("abs(-5): ")
    std.io.print_int(std.core.abs(-5))

    std.io.print_no_newline("min(3,7): ")
    std.io.print_int(std.core.min(3, 7))

    std.io.print_no_newline("max(3,7): ")
    std.io.print_int(std.core.max(3, 7))

    return 0
