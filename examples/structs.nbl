# Nimble Structs Demo
# Structs with named fields, field access, and functions

load std.io

struct Point:
    let x: Int = 0
    let y: Int = 0

struct Rectangle:
    let width: Int = 0
    let height: Int = 0

fn area(r: Rectangle) -> Int:
    return r.width * r.height

fn perimeter(r: Rectangle) -> Int:
    return 2 * (r.width + r.height)

fn main() -> Int:
    let p = Point{x: 3, y: 4}
    std.io.print_no_newline("x: ")
    std.io.print_int(p.x)
    std.io.print_no_newline("y: ")
    std.io.print_int(p.y)

    let rect = Rectangle{width: 10, height: 5}
    std.io.print_no_newline("area: ")
    std.io.print_int(area(rect))
    std.io.print_no_newline("perimeter: ")
    std.io.print_int(perimeter(rect))

    return 0
