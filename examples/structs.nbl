# Nimble Structs Demo
# Structs with named fields, field access, and functions

extern fn nimble_print_str(s: String) -> Void
extern fn nimble_print_i64(x: Int) -> Void

struct Point:
    let x: Int = 0
    let y: Int = 0

struct Rectangle:
    let width: Int = 0
    let height: Int = 0

fn area(r: Rectangle) -> Int:
    return r.width * r.height

fn perimeter(r: Rectangle) -> Int:
    return 2 * (r.width + r.height)

fn main() -> Int:
    let p = Point{x: 3, y: 4}
    nimble_print_str("x: ")
    nimble_print_i64(p.x)
    nimble_print_str("y: ")
    nimble_print_i64(p.y)

    let rect = Rectangle{width: 10, height: 5}
    nimble_print_str("area: ")
    nimble_print_i64(area(rect))
    nimble_print_str("perimeter: ")
    nimble_print_i64(perimeter(rect))

    return 0
