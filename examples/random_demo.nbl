# Nimble Random Number Demo
# Demonstrates random number generation

load std.io
load std.random

fn main() -> Int:
    std.io.print_no_newline("random int: ")
    std.io.print_int(std.random.random_int())

    std.io.print_no_newline("random 0-99: ")
    std.io.print_int(std.random.random_range(0, 100))

    std.io.print_no_newline("random float: ")
    std.io.print_float(std.random.random_float())

    return 0
