# Nimble Control Flow Demo
# if/elif/else, while, break, continue

extern fn nimble_print_str(s: String) -> Void
extern fn nimble_print_i64(x: Int) -> Void

fn classify(n: Int) -> Int:
    if n > 0:
        return 1
    elif n < 0:
        return -1
    else:
        return 0

fn countdown(n: Int) -> Void:
    var i = n
    while i >= 0:
        nimble_print_i64(i)
        i = i - 1

fn main() -> Int:
    let sig = classify(42)
    nimble_print_i64(sig)

    countdown(5)

    var i = 0
    while i < 10:
        if i == 4:
            break
        nimble_print_i64(i)
        i = i + 1

    nimble_print_str("evens: ")
    var j = 0
    while j < 8:
        j = j + 1
        if j % 2 != 0:
            continue
        nimble_print_i64(j)

    return 0
