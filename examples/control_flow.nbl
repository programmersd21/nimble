# Nimble Control Flow Demo
# if/elif/else, while, break, continue

load std.io

fn classify(n: Int) -> Int:
    if n > 0:
        return 1
    elif n < 0:
        return -1
    else:
        return 0

fn countdown(n: Int) -> Void:
    var i = n
    while i >= 0:
        std.io.print_int(i)
        i = i - 1

fn main() -> Int:
    let sig = classify(42)
    std.io.print_int(sig)

    countdown(5)

    var i = 0
    while i < 10:
        if i == 4:
            break
        std.io.print_int(i)
        i = i + 1

    std.io.print_no_newline("evens: ")
    var j = 0
    while j < 8:
        j = j + 1
        if j % 2 != 0:
            continue
        std.io.print_int(j)

    return 0
