extern fn print_int(x: Int) -> Void
extern fn print_str(x: String) -> Void

fn classify(n: Int) -> Int:
    if n > 0:
        return 1
    elif n < 0:
        return -1
    else:
        return 0

fn countdown(n: Int) -> Void:
    var i = n
    while i >= 0:
        print_int(i)
        i = i - 1

fn main() -> Int:
    let sig = classify(42)
    print_int(sig)

    countdown(5)

    # break: exit loop early
    var i = 0
    while i < 10:
        if i == 4:
            break
        print_int(i)
        i = i + 1

    # continue: skip odd numbers
    print_str("evens: ")
    var j = 0
    while j < 8:
        j = j + 1
        if j % 2 != 0:
            continue
        print_int(j)

    return 0
