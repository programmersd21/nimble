# Nimble Variables Demo
# Immutable (let) and mutable (var) bindings, compound assignment

load std.io

fn main() -> Int:
    let x = 42
    std.io.print_int(x)

    var y = 10
    y = 20
    std.io.print_int(y)

    y += 5
    std.io.print_int(y)

    y -= 3
    std.io.print_int(y)

    y *= 2
    std.io.print_int(y)

    y /= 4
    std.io.print_int(y)

    y %= 3
    std.io.print_int(y)

    return 0
