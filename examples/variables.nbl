# Nimble Variables Demo
# Immutable (let) and mutable (var) bindings, compound assignment

extern fn nimble_print_i64(x: Int) -> Void

fn main() -> Int:
    let x = 42
    nimble_print_i64(x)

    var y = 10
    y = 20
    nimble_print_i64(y)

    y += 5
    nimble_print_i64(y)

    y -= 3
    nimble_print_i64(y)

    y *= 2
    nimble_print_i64(y)

    y /= 4
    nimble_print_i64(y)

    y %= 3
    nimble_print_i64(y)

    return 0
