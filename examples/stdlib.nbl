# Nimble Standard Library Demo
# Demonstrates runtime-backed operations (core math, string, encoding, hash)

load std.io
load std.core
load std.str
load std.hash
load std.random
load std.encoding.base64

fn main() -> Int:
    # Core math backed by runtime
    std.io.print_no_newline("abs(-5): ")
    std.io.print_int(std.core.abs(-5))

    std.io.print_no_newline("max(3,7): ")
    std.io.print_int(std.core.max(3, 7))

    std.io.print_no_newline("min(3,7): ")
    std.io.print_int(std.core.min(3, 7))

    std.io.print_no_newline("clamp(10,0,5): ")
    std.io.print_int(std.core.clamp(10, 0, 5))

    std.io.print_no_newline("popcount(42): ")
    std.io.print_int(std.core.count_ones(42))

    # String operations
    let msg = "  hello world  "
    let len = std.str.length(msg)
    std.io.print_no_newline("length: ")
    std.io.print_int(len)

    let upper = std.str.to_upper(msg)
    std.io.print_no_newline("upper: ")
    std.io.print(upper)

    let trimmed = std.str.trim(msg)
    std.io.print_no_newline("trimmed: ")
    std.io.print(trimmed)

    # Hashing
    let data = "nimble"
    let h1 = std.hash.fnv1a(data)
    let h2 = std.hash.sip(data)
    std.io.print_no_newline("fnv1a hash: ")
    std.io.print_int(h1)
    std.io.print_no_newline("sip hash: ")
    std.io.print_int(h2)

    # Random numbers
    let r = std.random.random_range(1, 100)
    std.io.print_no_newline("random 1-100: ")
    std.io.print_int(r)

    # Base64 encoding
    let encoded = std.encoding.base64.encode_b64("hello")
    std.io.print_no_newline("base64: ")
    std.io.print(encoded)

    return 0
