extern fn print_int(x: Int) -> Void
extern fn print_str(x: String) -> Void

fn max_i(a: Int, b: Int) -> Int:
    if a > b:
        return a
    return b

fn min_i(a: Int, b: Int) -> Int:
    if a < b:
        return a
    return b

fn clamp(x: Int, lo: Int, hi: Int) -> Int:
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

fn main() -> Int:
    print_str("max(3,7): ")
    print_int(max_i(3, 7))

    print_str("min(3,7): ")
    print_int(min_i(3, 7))

    print_str("clamp(10,0,5): ")
    print_int(clamp(10, 0, 5))

    return 0
