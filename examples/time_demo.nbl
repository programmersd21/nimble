# Nimble Time Demo
# Demonstrates time and sleep functions

load std.io
load std.time

fn main() -> Int:
    let t = std.time.now()
    std.io.print_no_newline("unix timestamp: ")
    std.io.print_int(t)

    std.io.print_no_newline("sleeping for 500ms...")
    std.time.sleep(500)
    std.io.print("done")

    return 0
