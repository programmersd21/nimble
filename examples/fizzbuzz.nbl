# Nimble FizzBuzz
# Classic programming puzzle with control flow

load std.io

fn fizzbuzz(n: Int) -> Void:
    if n % 3 == 0 && n % 5 == 0:
        std.io.print("FizzBuzz")
    elif n % 3 == 0:
        std.io.print("Fizz")
    elif n % 5 == 0:
        std.io.print("Buzz")
    else:
        std.io.print_int(n)

fn main() -> Int:
    var i = 1
    while i <= 100:
        fizzbuzz(i)
        i = i + 1
    return 0
