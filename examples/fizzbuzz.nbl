# Nimble FizzBuzz
# Classic programming puzzle with control flow

extern fn nimble_print_str(s: String) -> Void
extern fn nimble_print_i64(x: Int) -> Void

fn fizzbuzz(n: Int) -> Void:
    if n % 3 == 0 && n % 5 == 0:
        nimble_print_str("FizzBuzz")
    elif n % 3 == 0:
        nimble_print_str("Fizz")
    elif n % 5 == 0:
        nimble_print_str("Buzz")
    else:
        nimble_print_i64(n)

fn main() -> Int:
    var i = 1
    while i <= 100:
        fizzbuzz(i)
        i = i + 1
    return 0
